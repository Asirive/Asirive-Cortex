/* Asirive Cortex FULL mode — dark theme
   v2 layout: 3x3 grid, Layer 2 (Gemini Live) takes a 2x2 block (top-right 4 cells).
   The other 5 panels fill the remaining 5 cells. */

Screen {
    background: $surface;
    color: $text;
}

Header {
    background: #001f3f;
    color: #ffffff;
    text-style: bold;
}

Footer {
    background: #001f3f;
    color: #cccccc;
}

#body {
    layout: grid;
    grid-size: 3 3;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: 1fr 1fr 1fr;
    grid-gutter: 1 1;
    margin: 0 1;
}

/* Layer 2 spans 2 cols × 2 rows = the dominant panel */
#layer2 {
    column-span: 2;
    row-span: 2;
    border: tall magenta;
    padding: 0 1;
}

/* Other panels: 1 cell each */
#detection, #sensors, #system, #tts, #memory {
    border: tall blue;
    padding: 0 1;
}

#sensors {
    border: tall green;
    /* min-height: 12 keeps the new Power + status lines visible in
       standard 180×70 terminals (was clipping at 5 rows in v6) */
    min-height: 12;
}

#system {
    border: tall yellow;
}

#tts {
    border: tall cyan;
}

#memory {
    border: tall magenta;
}

#log {
    height: 40%;
    min-height: 14;
    margin: 1 1 0 1;
    border: tall green;
    padding: 0 1;
    background: #0a0a0a;
    scrollbar-background: #0a0a0a;
    scrollbar-color: #444;
}

/* Activity feed — full-width timeline above the logs */
#activity {
    height: 9;
    min-height: 9;
    margin: 1 1 0 1;
    border: tall yellow;
    padding: 0 1;
    background: #0a0a0a;
}
