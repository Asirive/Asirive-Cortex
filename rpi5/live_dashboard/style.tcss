/* Asirive Cortex FULL mode — dark theme
   v3 layout: ONE outer cyan border wraps everything. Inner panels are
   borderless grid cells; the Rich Panel renderable inside each Static
   still carries its title bar so sections are visible. This saves the
   ~24 lines that double-borders were eating (CSS border + Rich Panel
   border × 6 panels). */

Screen {
    background: $surface;
    color: $text;
}

Header {
    background: #001f3f;
    color: #ffffff;
    text-style: bold;
}

Footer {
    background: #001f3f;
    color: #cccccc;
}

/* ONE outer box around the whole content area.
   Fills all vertical space between Header and Footer. */
#outer {
    border: tall cyan;
    height: 1fr;
    margin: 0 1;
    padding: 0 1;
}

/* 3x3 grid. Layer 2 (Gemini Live) takes cols 2-3, rows 1-2 (4 cells).
   The other 5 panels fill the remaining 5 cells.
   2fr = body gets 2/3 of remaining vertical space, log gets 1/3. */
#body {
    layout: grid;
    grid-size: 3 3;
    grid-columns: 1fr 1fr 1fr;
    grid-rows: 1fr 1fr 1fr;
    grid-gutter: 0;
    height: 2fr;
}

/* Inner panels: NO border (they're grid cells). The Rich Panel renderable
   inside each Static draws its own title bar for section identification.
   Do NOT set height: 1fr here — the grid's grid-rows: 1fr 1fr 1fr
   already handles row sizing, and a competing 1fr on the cell was
   leaving 1x1 cells with ~1 line (just the title). */
#detection, #layer2, #sensors, #system, #tts, #memory {
    border: none;
    padding: 0 1;
}

/* Activity feed — full-width timeline. Fixed 8 lines, no border
   (the dividers inside the renderable separate it from #log). */
#activity {
    height: 8;
    min-height: 8;
    border: none;
    padding: 0 1;
    background: #0a0a0a;
}

/* Log viewer. max_lines is enforced in the widget constructor; the CSS
   just gives it a reasonable height and a distinct background so it
   reads as a separate "console" section. */
#log {
    height: 1fr;
    min-height: 10;
    border: tall green;
    padding: 0 1;
    background: #0a0a0a;
    scrollbar-background: #0a0a0a;
    scrollbar-color: #444;
}
