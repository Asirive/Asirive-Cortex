/* Asirive Cortex FULL mode — dark theme
   v4 layout: nested Horizontal/Vertical containers instead of a 3x3 grid.
   Textual's Grid can't cell-span, so we use nested containers to give
   the CLOUD AI panel (#layer2) a 2/3-width, full-height position on the
   right, with detection + sensors stacked on the left, and system/tts/memory
   in a bottom row. Inner panels are borderless; the Rich Panel renderable
   inside each Static draws its own title bar. */

Screen {
    background: $surface;
    color: $text;
}

Header {
    background: #001f3f;
    color: #ffffff;
    text-style: bold;
}

Footer {
    background: #001f3f;
    color: #cccccc;
}

/* ONE outer box around the whole content area.
   Fills all vertical space between Header and Footer. */
#outer {
    border: tall cyan;
    height: 1fr;
    margin: 0 1;
    padding: 0 1;
}

/* Body: vertical stack of top-row (2fr) + bottom-row (1fr).
   2fr body + activity(8) + log(1fr) fills the outer container. */
#body {
    layout: vertical;
    height: 2fr;
}

/* Top row: left column (1fr width) + layer2 (2fr width).
   Takes 2/3 of the body height. */
#top-row {
    layout: horizontal;
    height: 2fr;
}

/* Left column: detection (top) + sensors (bottom), stacked vertically. */
#left-col {
    layout: vertical;
    width: 1fr;
    height: 1fr;
}

/* Layer 2 (CLOUD AI) — the big panel, 2/3 width, full top-row height. */
#layer2 {
    width: 2fr;
    height: 1fr;
    border: none;
    padding: 0 1;
}

/* Bottom row: system + tts + memory, each 1fr width.
   Takes 1/3 of the body height. */
#bottom-row {
    layout: horizontal;
    height: 1fr;
}

/* Inner panels: NO border. The Rich Panel renderable inside each Static
   draws its own title bar for section identification. */
#detection, #sensors {
    height: 1fr;
    border: none;
    padding: 0 1;
}

#system, #tts, #memory {
    width: 1fr;
    height: 1fr;
    border: none;
    padding: 0 1;
}

/* Activity feed — full-width timeline. 10 lines to fit 8 events + footer. */
#activity {
    height: 10;
    min-height: 6;
    border: none;
    padding: 0 1;
    background: #0a0a0a;
}

/* Log viewer. max_lines is enforced in the widget constructor; the CSS
   just gives it a reasonable height and a distinct background so it
   reads as a separate "console" section. min-height lowered to 4 so
   small terminals (24 lines) don't starve the body panels. */
#log {
    height: 1fr;
    min-height: 4;
    border: tall green;
    padding: 0 1;
    background: #0a0a0a;
    scrollbar-background: #0a0a0a;
    scrollbar-color: #444;
}
