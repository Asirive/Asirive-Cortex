# copy to .env and fill in. Never commit .env.
API_DOMAIN=api.asirive.com
TURN_REALM=asirive.com
CORTEX_DEV_TOKEN=change-me-bootstrap-admin
CORTEX_OTA_PUBKEY=            # hex ed25519 public key from `cortex-sign keygen`; private key stays OFF this server
RESEND_API_KEY=
CORTEX_MAIL_FROM=Asirive <no-reply@asirive.com>
CORTEX_APP_LINK_BASE=asirive://
CORTEX_TURN_SECRET=           # openssl rand -hex 32
CORTEX_TURN_URLS=turn:turn.asirive.com:3478?transport=udp,turn:turn.asirive.com:3478?transport=tcp
CORTEX_FCM_SERVICE_ACCOUNT=/secrets/fcm.json
CORTEX_APNS_KEY=/secrets/AuthKey.p8
CORTEX_APNS_KEY_ID=
CORTEX_APNS_TEAM_ID=
CORTEX_APNS_TOPIC=com.asirive.cortex
