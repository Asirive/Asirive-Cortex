Screen {
    background: #0A0A08;
    color: #D8D8D0;
}

#title {
    height: 1;
    padding: 0 1;
    color: #0A0A08;
    background: #EAFF00;
    text-style: bold;
}

#panels {
    grid-size: 2 3;
    grid-rows: 7 2fr 1fr;
    grid-gutter: 0 1;
    padding: 0 1;
}

.panel {
    border: round #EAFF00;
    border-title-color: #EAFF00;
    border-title-style: bold;
    padding: 0 1;
    background: #0A0A08;
}

.wide {
    column-span: 2;
}

Footer {
    background: #0A0A08;
}
